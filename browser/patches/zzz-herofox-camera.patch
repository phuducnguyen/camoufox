+ * You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#ifndef DOM_MEDIA_SYSTEMSERVICES_HEROCAMERAPIPE_H_
+#define DOM_MEDIA_SYSTEMSERVICES_HEROCAMERAPIPE_H_
+
+#include "mozilla/Mutex.h"
+#include "mozilla/ThreadSafety.h"
+#include "nsISupportsImpl.h"
+#include "nsString.h"
+#include "nsTArray.h"
+
+#ifdef XP_WIN
+#  include <atomic>
+
+#  include "prthread.h"
+#endif
+
+namespace mozilla {
+
+/**
+ * The launcher's side of a virtual camera: a named pipe carrying I420 frames.
+ *
+ * The producer (Hero Browser) writes fixed 24-byte headers followed by one
+ * frame; this reader keeps the latest complete frame so the fake video source
+ * can publish it. It runs in the parent process, behind CamerasParent, so the
+ * page gets the frames the way it gets a physical webcam's: over the camera
+ * IPC, with the content sandbox never touching the pipe. Only Windows has the
+ * producer, so other platforms compile every entry point as a no-op.
+ */
+class HeroCameraPipe {
+ public:
+  NS_INLINE_DECL_THREADSAFE_REFCOUNTING(HeroCameraPipe)
+
+  /// True when the launcher serves this profile's cameras (the profile id is
+  /// in the config and at least one lens has media). Then the camera backend
+  /// lists the identity's webcams and fills them from the pipes.
+  static bool Served();
+  /// How many webcams the identity has (mediaDevices:webcams, at least 1).
+  static uint32_t DeviceCount();
+  /// "camou-cam-<i>": 0 is the back lens, 1 the front lens.
+  static nsCString DeviceId(uint32_t aIndex);
+  /// The identity's label for webcam <i>.
+  static nsCString DeviceLabel(uint32_t aIndex);
+  /// The pipe for a device id, or empty when that lens has no media (then the
+  /// camera shows the generated test pattern, as before).
+  static nsString PipeNameForDevice(const char* aDeviceId);
+  /// The size and rate the launcher encodes its frames at.
+  static void SourceSize(uint32_t* aWidth, uint32_t* aHeight);
+  static uint32_t SourceFps();
+  /// Nearest-neighbour I420 resize; a smaller size is what a page asks for when
+  /// it wants less than the camera's native size.
+  static void ScaleI420(const uint8_t* aSrc, int32_t aSrcWidth,
+                        int32_t aSrcHeight, uint8_t* aDst, int32_t aDstWidth,
+                        int32_t aDstHeight);
+
+  explicit HeroCameraPipe(const nsAString& aName);
+
+  /// Opens the pipe and starts reading. Frames that do not match the size the
+  /// launcher encodes are dropped, so the track never gets a half frame.
+  void Start(uint32_t aWidth, uint32_t aHeight);
+  /// Closes the pipe and joins the reader. Safe to call more than once.
+  void Stop();
+
+  /// Copies the newest complete frame if one arrived since the last call; false
+  /// when there is nothing new, so a caller running faster than the producer
+  /// never publishes the same frame twice.
+  bool CopyLatest(nsTArray<uint8_t>& aOut, int32_t* aWidth, int32_t* aHeight);
+
+ private:
+  ~HeroCameraPipe();
+
+#ifdef XP_WIN
+  static void ReadLoopTrampoline(void* aArg);
+  void ReadLoop();
+  const nsString mName;
+  std::atomic<bool> mStop{false};
+  std::atomic<void*> mHandle{nullptr};
+  PRThread* mThread = nullptr;
+  uint32_t mExpectedWidth = 0;
+  uint32_t mExpectedHeight = 0;
+#endif
+
+  Mutex mMutex{"HeroCameraPipe::mMutex"};
+  nsTArray<uint8_t> mFrame MOZ_GUARDED_BY(mMutex);
+  int32_t mWidth MOZ_GUARDED_BY(mMutex) = 0;
+  int32_t mHeight MOZ_GUARDED_BY(mMutex) = 0;
+  bool mHasNewFrame MOZ_GUARDED_BY(mMutex) = false;
+};
+
+}  // namespace mozilla
