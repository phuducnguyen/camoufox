+int32_t HeroDeviceIndex(const char* aId) {
+  uint32_t index = 0;
+  char tail = 0;
+  if (sscanf(aId, "camou-cam-%u%c", &index, &tail) != 1 ||
+      index >= HeroCameraPipe::DeviceCount()) {
+    return -1;
+  }
+  return static_cast<int32_t>(index);
+}
+
+// A webcam lists its native size and the halves below it, so the launcher's one
+// size serves what a page may ask for; nothing is ever listed above it.
+bool HeroCapability(uint32_t aNumber, VideoCaptureCapability& aCapability) {
+  uint32_t width = 0;
+  uint32_t height = 0;
+  HeroCameraPipe::SourceSize(&width, &height);
+  uint32_t found = 0;
+  for (uint32_t shift = 0; shift < 4; ++shift) {
+    const uint32_t w = (width >> shift) & ~1u;
+    const uint32_t h = (height >> shift) & ~1u;
+    if (w < 160 || h < 90) {
+      break;
+    }
+    if (found++ == aNumber) {
+      aCapability.width = static_cast<int32_t>(w);
+      aCapability.height = static_cast<int32_t>(h);
+      aCapability.maxFPS = static_cast<int32_t>(HeroCameraPipe::SourceFps());
+      aCapability.videoType = VideoType::kI420;
+      return true;
+    }
+  }
+  return false;
