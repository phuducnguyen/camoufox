+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this file,
+ * You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "HeroCameraPipe.h"
+
+#include <algorithm>
+#include <cstring>
+#include <string>
+#include <vector>
+
+#include "MaskConfig.hpp"
+#include "mozilla/RefPtr.h"
+#include "mozilla/fallible.h"
+
+#ifdef XP_WIN
+#  include <windows.h>
+#endif
+
+namespace mozilla {
+
+namespace {
+
+constexpr uint32_t kMaxWidth = 1920;
+constexpr uint32_t kMaxHeight = 1080;
+constexpr uint32_t kDefaultWidth = 640;
+constexpr uint32_t kDefaultHeight = 480;
+
+void ScalePlane(const uint8_t* aSrc, int32_t aSrcW, int32_t aSrcH,
+                uint8_t* aDst, int32_t aDstW, int32_t aDstH) {
+  std::vector<int32_t> columns(static_cast<size_t>(aDstW));
+  for (int32_t x = 0; x < aDstW; ++x) {
+    columns[x] = static_cast<int32_t>(static_cast<int64_t>(x) * aSrcW / aDstW);
+  }
+  for (int32_t y = 0; y < aDstH; ++y) {
+    const uint8_t* row =
+        aSrc + static_cast<size_t>(static_cast<int64_t>(y) * aSrcH / aDstH) *
+                   aSrcW;
+    uint8_t* out = aDst + static_cast<size_t>(y) * aDstW;
+    for (int32_t x = 0; x < aDstW; ++x) {
+      out[x] = row[columns[x]];
+    }
+  }
+}
+
+}  // namespace
+
+/*static*/ bool HeroCameraPipe::Served() {
+#ifdef XP_WIN
+  return MaskConfig::GetString("camera.profile") &&
+         (MaskConfig::GetBool("camera.back") ||
+          MaskConfig::GetBool("camera.front"));
+#else
+  return false;
+#endif
+}
+
+/*static*/ uint32_t HeroCameraPipe::DeviceCount() {
+  const uint32_t count =
+      MaskConfig::GetUint32("mediaDevices:webcams").value_or(1);
+  return std::clamp<uint32_t>(count, 1, 4);
+}
+
+/*static*/ nsCString HeroCameraPipe::DeviceId(uint32_t aIndex) {
+  nsCString id;
+  id.AppendPrintf("camou-cam-%u", aIndex);
+  return id;
+}
+
+/*static*/ nsCString HeroCameraPipe::DeviceLabel(uint32_t aIndex) {
+  const auto labels = MaskConfig::GetStringList("mediaDevices:webcamLabels");
+  if (aIndex < labels.size()) {
+    return nsCString(labels[aIndex].c_str());
+  }
+  return nsCString("Integrated Camera");
+}
+
+/*static*/ nsString HeroCameraPipe::PipeNameForDevice(const char* aDeviceId) {
+#ifdef XP_WIN
+  // The identity's two lenses are camou-cam-0 (back) and camou-cam-1 (front).
+  const bool front = strcmp(aDeviceId, "camou-cam-1") == 0;
+  if (!front && strcmp(aDeviceId, "camou-cam-0") != 0) {
+    return u""_ns;
+  }
+  const auto profile = MaskConfig::GetString("camera.profile");
+  if (!profile ||
+      !MaskConfig::GetBool(front ? "camera.front" : "camera.back")) {
+    return u""_ns;
+  }
+  nsString pipe(u"\\\\.\\pipe\\hero-camera-"_ns);
+  pipe.Append(NS_ConvertUTF8toUTF16(profile->c_str()));
+  pipe.Append(front ? u"-front"_ns : u"-back"_ns);
+  return pipe;
+#else
+  (void)aDeviceId;
+  return u""_ns;
+#endif
+}
+
+/*static*/ void HeroCameraPipe::SourceSize(uint32_t* aWidth,
+                                           uint32_t* aHeight) {
+  uint32_t width =
+      MaskConfig::GetUint32("camera.width").value_or(kDefaultWidth);
+  uint32_t height =
+      MaskConfig::GetUint32("camera.height").value_or(kDefaultHeight);
+  if (width == 0 || height == 0 || (width & 1) || (height & 1) ||
+      width > kMaxWidth || height > kMaxHeight) {
+    width = kDefaultWidth;
+    height = kDefaultHeight;
+  }
+  *aWidth = width;
+  *aHeight = height;
+}
+
+/*static*/ uint32_t HeroCameraPipe::SourceFps() {
+  return std::clamp<uint32_t>(MaskConfig::GetUint32("camera.fps").value_or(30),
+                              1, 60);
+}
+
+/*static*/ void HeroCameraPipe::ScaleI420(const uint8_t* aSrc,
+                                          int32_t aSrcWidth,
+                                          int32_t aSrcHeight, uint8_t* aDst,
+                                          int32_t aDstWidth,
+                                          int32_t aDstHeight) {
+  const size_t srcY = static_cast<size_t>(aSrcWidth) * aSrcHeight;
+  const size_t dstY = static_cast<size_t>(aDstWidth) * aDstHeight;
+  if (aSrcWidth == aDstWidth && aSrcHeight == aDstHeight) {
+    memcpy(aDst, aSrc, dstY + dstY / 2);
+    return;
+  }
+  // shortcut: nearest neighbour, only ever used to go down from the native
+  // size; upgrade to a box filter if a page's downscaled preview looks harsh.
+  ScalePlane(aSrc, aSrcWidth, aSrcHeight, aDst, aDstWidth, aDstHeight);
+  ScalePlane(aSrc + srcY, aSrcWidth / 2, aSrcHeight / 2, aDst + dstY,
+             aDstWidth / 2, aDstHeight / 2);
+  ScalePlane(aSrc + srcY + srcY / 4, aSrcWidth / 2, aSrcHeight / 2,
+             aDst + dstY + dstY / 4, aDstWidth / 2, aDstHeight / 2);
+}
+
+#ifdef XP_WIN
+namespace {
+
+constexpr size_t kHeaderLength = 24;
+// The launcher creates the pipe before the engine starts; this only covers the
+// gap while its producer thread is being scheduled.
+constexpr int kConnectAttempts = 400;
+
+bool ReadExact(HANDLE aHandle, uint8_t* aData, size_t aLength) {
+  size_t read = 0;
+  while (read < aLength) {
+    DWORD chunk = 0;
+    if (!ReadFile(aHandle, aData + read, static_cast<DWORD>(aLength - read),
+                  &chunk, nullptr)) {
+      return false;
+    }
+    if (chunk == 0) {
+      return false;
+    }
+    read += chunk;
+  }
+  return true;
+}
+
+uint32_t LittleEndian32(const uint8_t* aData) {
+  return static_cast<uint32_t>(aData[0]) |
+         (static_cast<uint32_t>(aData[1]) << 8) |
+         (static_cast<uint32_t>(aData[2]) << 16) |
+         (static_cast<uint32_t>(aData[3]) << 24);
+}
+
+}  // namespace
+#endif
+
+HeroCameraPipe::HeroCameraPipe(const nsAString& aName)
+#ifdef XP_WIN
+    : mName(aName)
+#endif
+{
+#ifndef XP_WIN
+  (void)aName;
+#endif
+}
+
+HeroCameraPipe::~HeroCameraPipe() { Stop(); }
+
+void HeroCameraPipe::Start(uint32_t aWidth, uint32_t aHeight) {
+#ifdef XP_WIN
+  if (mThread) {
+    return;
+  }
+  mStop = false;
+  mExpectedWidth = aWidth;
+  mExpectedHeight = aHeight;
+  {
+    MutexAutoLock lock(mMutex);
+    mHasNewFrame = false;
+  }
+  // The reader owns a reference for as long as it runs, so the object cannot
+  // go away under it; Stop() joins the thread before the owner lets go.
+  AddRef();
+  mThread = PR_CreateThread(PR_USER_THREAD, &HeroCameraPipe::ReadLoopTrampoline,
+                            this, PR_PRIORITY_NORMAL, PR_LOCAL_THREAD,
+                            PR_JOINABLE_THREAD, 0);
+  if (!mThread) {
+    Release();
+  }
+#else
+  (void)aWidth;
+  (void)aHeight;
+#endif
+}
+
+void HeroCameraPipe::Stop() {
+#ifdef XP_WIN
+  mStop = true;
+  if (void* handle = mHandle.exchange(nullptr)) {
+    // Closing the handle is what wakes a reader blocked in ReadFile.
+    ::CloseHandle(reinterpret_cast<HANDLE>(handle));
+  }
+  if (mThread) {
+    if (mThread != PR_GetCurrentThread()) {
+      PR_JoinThread(mThread);
+    }
+    // On the reader itself the thread ends with this object; joining would wait forever.
+    mThread = nullptr;
+  }
+#endif
+}
+
+bool HeroCameraPipe::CopyLatest(nsTArray<uint8_t>& aOut, int32_t* aWidth,
+                                int32_t* aHeight) {
+  MutexAutoLock lock(mMutex);
+  if (!mHasNewFrame) {
+    return false;
+  }
+  aOut.Assign(mFrame);
+  *aWidth = mWidth;
+  *aHeight = mHeight;
+  mHasNewFrame = false;
+  return true;
+}
+
+#ifdef XP_WIN
+/*static*/ void HeroCameraPipe::ReadLoopTrampoline(void* aArg) {
+  // Adopts the reference Start() took for the reader.
+  RefPtr<HeroCameraPipe> self = dont_AddRef(static_cast<HeroCameraPipe*>(aArg));
+  self->ReadLoop();
+}
+
+void HeroCameraPipe::ReadLoop() {
+  const uint32_t expectedWidth = mExpectedWidth;
+  const uint32_t expectedHeight = mExpectedHeight;
+  nsTArray<uint8_t> frame;
+
+  // The launcher can rebuild its pipe (profile relaunch, producer watchdog, a
+  // page that stopped and started the camera), so a closed handle is not the
+  // end of the camera: reconnect and keep the last frame until the new server
+  // has one.
+  while (!mStop) {
+    HANDLE handle = INVALID_HANDLE_VALUE;
+    for (int attempt = 0; attempt < kConnectAttempts && !mStop; ++attempt) {
+      handle = ::CreateFileW(
+          reinterpret_cast<const wchar_t*>(
+              static_cast<const char16_t*>(mName.get())),
+          GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, nullptr,
+          OPEN_EXISTING, 0, nullptr);
+      if (handle != INVALID_HANDLE_VALUE) {
+        break;
+      }
+      ::Sleep(50);
+    }
+    if (handle == INVALID_HANDLE_VALUE) {
+      return;
+    }
+    mHandle = reinterpret_cast<void*>(handle);
+    if (mStop) {
+      // Stop() ran between the open and the store above and found no handle to
+      // close; closing it here is what keeps the join from waiting forever.
+      if (mHandle.exchange(nullptr) == reinterpret_cast<void*>(handle)) {
+        ::CloseHandle(handle);
+      }
+      return;
+    }
+
+    while (!mStop) {
+      uint8_t header[kHeaderLength];
+      if (!ReadExact(handle, header, sizeof(header))) {
+        break;
+      }
+      if (memcmp(header, "HFV1", 4) != 0) {
+        break;
+      }
+      const uint32_t width = LittleEndian32(header + 4);
+      const uint32_t height = LittleEndian32(header + 8);
+      // The producer frames the video to one size. A frame of another size
+      // would make the track lie about its settings.
+      if (width != expectedWidth || height != expectedHeight || width == 0 ||
+          height == 0 || width > kMaxWidth || height > kMaxHeight ||
+          (width & 1) || (height & 1)) {
+        break;
+      }
+      const size_t yLength = static_cast<size_t>(width) * height;
+      const size_t frameLength = yLength + yLength / 2;
+      if (!frame.SetLength(frameLength, fallible)) {
+        break;
+      }
+      if (!ReadExact(handle, frame.Elements(), frameLength)) {
+        break;
+      }
+      {
+        // Swap, not copy: the buffer that goes back to the reader is the one
+        // the consumer already took, so a frame costs no allocation.
+        MutexAutoLock lock(mMutex);
+        mFrame.SwapElements(frame);
+        mWidth = static_cast<int32_t>(width);
+        mHeight = static_cast<int32_t>(height);
+        mHasNewFrame = true;
+      }
+    }
+
+    if (mHandle.exchange(nullptr) == reinterpret_cast<void*>(handle)) {
+      ::CloseHandle(handle);
+    }
+    if (mStop) {
+      return;
+    }
+    // Give the producer a moment to recreate the server; without it the
+    // reopen can land on the stale instance and fail again immediately.
+    for (int attempt = 0; attempt < 20 && !mStop; ++attempt) {
+      ::Sleep(50);
+    }
+  }
+}
+#endif
+
+}  // namespace mozilla
