diff --git a/layout/base/nsLayoutUtils.cpp b/layout/base/nsLayoutUtils.cpp
--- a/layout/base/nsLayoutUtils.cpp
+++ b/layout/base/nsLayoutUtils.cpp
@@ -9930,4 +9930,15 @@
     aStyle.systemFont = true;
     return;
   }
+  if (aOS == MaskConfig::SpoofedOS::Android) {
+    // Android's system face. Firefox for Android resolves every CSS2 system
+    // font keyword to the platform UI font, Roboto; the size is the default
+    // 16sp at a density-independent scale. CreepJS reads this family from
+    // getComputedStyle() and attributes it to an OS, so a Linux family here
+    // ("Ubuntu") marks the identity as Linux, not Android.
+    aName = u"Roboto"_ns;
+    aStyle.size = 16.0f;
+    aStyle.systemFont = true;
+    return;
+  }
   if (aOS == MaskConfig::SpoofedOS::Linux) {
diff --git a/layout/style/nsMediaFeatures.cpp b/layout/style/nsMediaFeatures.cpp
--- a/layout/style/nsMediaFeatures.cpp
+++ b/layout/style/nsMediaFeatures.cpp
@@ -193,6 +193,14 @@
   // introducing precision error from conversion to and from less-used
   // physical units like inches.
   nsPresContext* pc = aDocument->GetPresContext();
+  // Camoufox: the launch config pins window.devicePixelRatio; the resolution
+  // media feature (and (min-/max-)resolution, the dppx aliases) has to report
+  // the same ratio or a detector sees the two disagree ("lied dpr"). Zoom is
+  // applied the way nsGlobalWindowInner::GetDevicePixelRatio applies it.
+  if (auto dpr = MaskConfig::GetDouble("window.devicePixelRatio");
+      dpr && *dpr > 0) {
+    return static_cast<float>(*dpr) / (pc ? pc->GetFullZoom() : 1.0f);
+  }
   if (!pc) {
     return 1.;
   }
